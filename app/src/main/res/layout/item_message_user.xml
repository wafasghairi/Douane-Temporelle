<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="end"
    android:orientation="vertical"
    android:paddingStart="48dp"
    android:paddingTop="4dp"
    android:paddingEnd="12dp"
    android:paddingBottom="4dp">

    <LinearLayout
        android:id="@+id/ll_bulle_user_ws"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bubble_user"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_message_user_ws"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/couleur_encre_noire"
            android:textDirection="firstStrong"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tv_heure_user_ws"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="3dp"
            android:fontFamily="sans-serif"
            android:textColor="#5A4A3A"
            android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>
