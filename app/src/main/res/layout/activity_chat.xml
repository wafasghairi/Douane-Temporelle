<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rl_root_chat_ws"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/couleur_fond_sombre">

    <LinearLayout
        android:id="@+id/ll_header_chat_ws"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:background="@color/couleur_carte_sombre"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp">

        <Button
            android:id="@+id/btn_retour_chat_ws"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_button_restart"
            android:contentDescription="@string/desc_bouton_retour"
            android:text="◀"
            android:textColor="@color/white"
            android:textSize="16sp" />

        <LinearLayout
            android:id="@+id/ll_titre_conteneur_ws"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_titre_chat_ws"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="@string/titre_chat_douanier"
                android:textColor="@color/couleur_or_temporel"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_mode_ws"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif"
                android:text="@string/chat_mode_online"
                android:textColor="@color/couleur_texte_secondaire"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/hsv_langues_ws"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/ll_header_chat_ws"
        android:background="#14202A"
        android:paddingStart="8dp"
        android:paddingTop="6dp"
        android:paddingEnd="8dp"
        android:paddingBottom="6dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/ll_chips_container_ws"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/chip_fr_ws"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_chip_language"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/chip_label_fr"
                android:textAllCaps="false"
                android:textColor="@color/couleur_texte_clair"
                android:textSize="12sp" />

            <Button
                android:id="@+id/chip_en_ws"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_chip_language"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/chip_label_en"
                android:textAllCaps="false"
                android:textColor="@color/couleur_texte_clair"
                android:textSize="12sp" />

            <Button
                android:id="@+id/chip_ar_ws"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_chip_language"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/chip_label_ar"
                android:textAllCaps="false"
                android:textColor="@color/couleur_texte_clair"
                android:textSize="12sp" />

            <Button
                android:id="@+id/chip_tn_ws"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_chip_language"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/chip_label_tn"
                android:textAllCaps="false"
                android:textColor="@color/couleur_texte_clair"
                android:textSize="12sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <LinearLayout
        android:id="@+id/ll_input_bar_ws"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/couleur_carte_sombre"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp">

        <EditText
            android:id="@+id/et_message_ws"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_input_field"
            android:fontFamily="sans-serif"
            android:hint="@string/hint_ecrire_message"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="3"
            android:textColor="@color/couleur_encre_noire"
            android:textColorHint="@color/couleur_encre_secondaire"
            android:textDirection="firstStrong"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_envoyer_ws"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_button_gold"
            android:fontFamily="monospace"
            android:minWidth="72dp"
            android:text="@string/btn_envoyer_message"
            android:textColor="@color/couleur_encre_noire"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ListView
        android:id="@+id/lv_messages_ws"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/ll_input_bar_ws"
        android:layout_below="@+id/hsv_langues_ws"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:stackFromBottom="true"
        android:transcriptMode="alwaysScroll" />

</RelativeLayout>
