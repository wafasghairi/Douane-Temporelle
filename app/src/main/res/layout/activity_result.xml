<?xml version="1.0" encoding="utf-8"?>
<!-- الواجهة الثالثة لعرض القرار النهائي للجمارك مع خلفية برمجية وزر العودة بتعليقات عربية وأرقام 0-9 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ll_root_resultat_ws"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- العنوان الرسمي للقرار الصادر من الجمارك الزمنية -->
    <TextView
        android:id="@+id/tv_titre_verdict_ws"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:letterSpacing="0.1"
        android:text="@string/titre_decision_douane"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- ختم القرار البصري (موافقة أو رفض) بنمط التأشيرة الرسمية -->
    <TextView
        android:id="@+id/tv_stamp_verdict_ws"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:background="@drawable/bg_stamp_approved"
        android:fontFamily="monospace"
        android:gravity="center"
        android:letterSpacing="0.15"
        android:rotation="-6"
        android:text="@string/stamp_approuve"
        android:textColor="@color/white"
        android:textSize="24sp"
        android:textStyle="bold" />

    <!-- رسالة القرار المخصصة باسم المسافر -->
    <TextView
        android:id="@+id/tv_resultat_ws"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:fontFamily="monospace"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:textColor="@color/white"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- عرض تفاصيل إضافية عن الفارق الزمني المحسوب للمسافر -->
    <TextView
        android:id="@+id/tv_details_verdict_ws"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="monospace"
        android:textColor="#E0E0E0"
        android:textSize="14sp" />

    <!-- زر إعادة فتح استمارة مسافر جديد وإغلاق كافة الأنشطة السابقة -->
    <Button
        android:id="@+id/btn_nouveau_voyageur_ws"
        android:layout_width="wrap_content"
        android:layout_height="52dp"
        android:layout_marginTop="40dp"
        android:background="@drawable/bg_button_restart"
        android:fontFamily="monospace"
        android:minWidth="220dp"
        android:text="@string/btn_nouveau_voyageur"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textStyle="bold" />
</LinearLayout>
