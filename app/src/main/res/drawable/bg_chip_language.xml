<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/couleur_or_accent" />
            <corners android:radius="16dp" />
            <padding
                android:bottom="6dp"
                android:left="12dp"
                android:right="12dp"
                android:top="6dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/couleur_carte_sombre" />
            <stroke
                android:width="1dp"
                android:color="@color/couleur_or_temporel" />
            <corners android:radius="16dp" />
            <padding
                android:bottom="6dp"
                android:left="12dp"
                android:right="12dp"
                android:top="6dp" />
        </shape>
    </item>
</selector>
