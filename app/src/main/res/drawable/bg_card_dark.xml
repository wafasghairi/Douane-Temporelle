<?xml version="1.0" encoding="utf-8"?>
<!-- بطاقة الحاوية المظلمة الأنيقة لشاشة التسجيل الرئيسية بزوايا 12dp -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/couleur_carte_sombre" />
    <stroke
        android:width="1dp"
        android:color="@color/couleur_carte_bordure" />
    <corners android:radius="12dp" />
    <padding
        android:bottom="20dp"
        android:left="20dp"
        android:right="20dp"
        android:top="20dp" />
</shape>
