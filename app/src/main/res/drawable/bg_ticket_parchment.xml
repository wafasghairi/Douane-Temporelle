<?xml version="1.0" encoding="utf-8"?>
<!-- خلفية التذكرة الورقية القديمة مع إطار بني داكن وزوايا مستديرة 8dp -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- لون الورق العتيق المستوحى من وثائق السفر التاريخية -->
    <solid android:color="@color/couleur_parchemin" />
    <stroke
        android:width="3dp"
        android:color="@color/couleur_bordure_parchemin" />
    <corners android:radius="8dp" />
    <padding
        android:bottom="16dp"
        android:left="16dp"
        android:right="16dp"
        android:top="16dp" />
</shape>
